#!/command/with-contenv bash
# shellcheck shell=bash
# Prepare OwnTone + go-librespot from the Home Assistant app options.
set -e

OPTIONS=/data/options.json
opt() { python3 -c "import json,sys;d=json.load(open('$OPTIONS'));v=d.get('$1','$2');print(str(v).lower() if isinstance(v,bool) else v)"; }

DEVICE_NAME="$(opt device_name 'Home Flex')"
BITRATE="$(opt bitrate 320)"
NORMALISATION="$(opt normalisation true)"
ZEROCONF="$(opt zeroconf false)"
LOG_LEVEL="$(opt log_level info)"

echo "[spotify-flex] device '${DEVICE_NAME}', bitrate ${BITRATE}, zeroconf ${ZEROCONF}"

# --- audio pipe between go-librespot and OwnTone -----------------------------
mkdir -p /music /config/owntone /config/go-librespot /data /run/dbus /run/avahi-daemon
[ -s /etc/machine-id ] || dbus-uuidgen --ensure=/etc/machine-id
rm -f /run/dbus/dbus.pid /run/dbus/pid /run/avahi-daemon/pid
[ -p /music/spotify ] || { rm -f /music/spotify; mkfifo /music/spotify; }
chmod 666 /music/spotify
# metadata pipe: carries the Spotify track position to OwnTone (audible-position sync)
[ -p /music/spotify.metadata ] || { rm -f /music/spotify.metadata; mkfifo /music/spotify.metadata; }
chmod 666 /music/spotify.metadata

# --- OwnTone: only the pipe as library, only localhost may control it --------
cat > /config/owntone/owntone.conf <<EOF
general {
	uid = "owntone"
	db_path = "/config/owntone/songs3.db"
	cache_dir = "/config/owntone"
	logfile = "/config/owntone/owntone.log"
	loglevel = warning
	admin_password = ""
	trusted_networks = { "localhost" }
	ipv6 = no
	# HomePod Software 27 validates the AirPlay User-Agent (owntone issue #2042).
	# OwnTone 29.3 sends general.user_agent to AirPlay devices.
	user_agent = "AirPlay/999.0.0"
}

library {
	name = "Spotify Flex"
	port = 3689
	directories = { "/music" }
	pipe_autostart = true
	filescan_disable = false
}

audio {
	nickname = "Spotify Flex"
	type = "disabled"
}

mpd {
	port = 0
}
EOF

# --- go-librespot -------------------------------------------------------------
NORM_DISABLED=false
[ "${NORMALISATION}" = "true" ] || NORM_DISABLED=true
cat > /config/go-librespot/config.yml <<EOF
log_level: ${LOG_LEVEL}
log_disable_timestamp: true
device_name: "${DEVICE_NAME}"
device_type: speaker
bitrate: ${BITRATE}
audio_backend: pipe
audio_output_pipe: /music/spotify
audio_output_pipe_format: s16le
initial_volume: 60
volume_steps: 100
normalisation_disabled: ${NORM_DISABLED}
zeroconf_enabled: ${ZEROCONF}
zeroconf_backend: avahi
credentials:
  type: device_auth
server:
  enabled: true
  address: 127.0.0.1
  port: 3678
  image_size: large
EOF

chown -R owntone:owntone /config/owntone /music
# --- route around Spotify servers this network cannot reach ------------------
( cd /opt/flex && timeout 60 python3 -m flex.netheal ) || echo "[spotify-flex] netheal skipped"

# --- AirPlay 2 needs the PTP ports 319/320 on the host -------------------------
python3 - <<'PY' || true
ports = {319: [], 320: []}
for f in ("/proc/net/udp", "/proc/net/udp6"):
    try:
        for line in open(f).read().splitlines()[1:]:
            local = line.split()[1]
            port = int(local.rsplit(":", 1)[1], 16)
            if port in ports:
                ports[port].append(local)
    except OSError:
        pass
busy = [p for p, v in ports.items() if v]
if busy:
    print(f"[spotify-flex] WARNUNG: PTP-Port(s) {busy} sind schon von einem anderen Programm belegt "
          "(z. B. Music Assistant mit AirPlay). Dann kann OwnTone keine AirPlay-2-Uhr betreiben "
          "und HomePods lassen sich nicht aktivieren.")
else:
    print("[spotify-flex] PTP-Ports 319/320 sind frei")
PY

echo "[spotify-flex] configuration ready"
